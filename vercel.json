{
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/app"
    },
    {
      "source": "/index.html",
      "destination": "/app"
    },
    {
      "source": "/login",
      "destination": "/app/login"
    },
    {
      "source": "/login.html",
      "destination": "/app/login"
    },
    {
      "source": "/register",
      "destination": "/app/register"
    },
    {
      "source": "/register.html",
      "destination": "/app/register"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://*.supabase.co; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ],
  "functions": {
    "api/csm-listing-title.js": {
      "maxDuration": 300,
      "regions": [
        "sin1"
      ]
    },
    "api/csm-listing-title-ingest.js": {
      "maxDuration": 300,
      "regions": [
        "sin1"
      ]
    },
    "api/listing-asset-create.js": {
      "regions": [
        "sin1"
      ]
    },
    "api/listing-image-upload-url.js": {
      "regions": [
        "sin1"
      ]
    },
    "api/listing-image-upload-relay.js": {
      "maxDuration": 30,
      "regions": [
        "sin1"
      ]
    },
    "api/listing-image-verify-upload.js": {
      "regions": [
        "sin1"
      ]
    }
  },
  "crons": [
    {
      "path": "/api/listing-storage-retention-cleanup",
      "schedule": "0 9 * * *"
    }
  ]
}
